# ============================================================
# Firebase (Client SDK - expuesto al navegador)
# ============================================================
# Las variables con prefijo NEXT_PUBLIC_ son visibles en el cliente.
# Cópialas desde Firebase Console → Configuración del proyecto → Tus apps.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Firebase Admin SDK (Servidor - API Routes)
# ============================================================
# JSON completo de la service account. Cópialo desde:
# Firebase Console → Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada → pegar el JSON completo aquí como string
# (sin saltos de línea o con \n escapados).
#
# IMPORTANTE: NO commitear este archivo con datos reales.

FIREBASE_SERVICE_ACCOUNT=
